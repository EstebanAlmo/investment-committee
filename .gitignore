data/raw/*
data/processed/*
data/reports/*
data/ledger/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep
!data/ledger/.gitkeep
# Human review notes of the trade viewer: local, never committed
data/reviews/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
