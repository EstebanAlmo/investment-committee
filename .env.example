# Copy this file to .env and fill in real values locally.
# .env is git-ignored and must never be committed.

# --- Telegram bot (required to run: python -m investment_committee.interfaces.telegram) ---
# TELEGRAM_ALLOWED_USER_IDS: comma-separated numeric Telegram user ids allowed to use the bot.
# TELEGRAM_BOT_TOKEN=0000000000:AAFAKE-TELEGRAM-BOT-TOKEN-PLACEHOLDER
# TELEGRAM_ALLOWED_USER_IDS=100000001,100000002

# --- AI committee (/committee) via DeepSeek's official API (optional, paid per use) ---
# Without DEEPSEEK_API_KEY the AI committee is disabled and everything else works.
# DEEPSEEK_MODEL: deepseek-flash (default) or deepseek-v4-pro.
# DEEPSEEK_MAX_OUTPUT_TOKENS: per-reply limit, default 1600 (900 left the longest agents no headroom).
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_TIMEOUT_SECONDS=
# DEEPSEEK_MAX_RETRIES=
# DEEPSEEK_MAX_OUTPUT_TOKENS=
# Per-analysis limits (defaults: 40000 tokens, 0.05 USD estimated).
# AI_COMMITTEE_MAX_TOKENS=
# AI_COMMITTEE_MAX_COST_USD=

# --- Market data providers (added when Market Intelligence layer is implemented) ---
# MARKET_DATA_API_KEY=
# NEWS_API_KEY=

# --- Storage (SQLite path, added when Memory and Storage layer is implemented) ---
# DATABASE_PATH=./data/investment_committee.sqlite3

# --- Application ---
# ENVIRONMENT=local
# LOG_LEVEL=INFO
